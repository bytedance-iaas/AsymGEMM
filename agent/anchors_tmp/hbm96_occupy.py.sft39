#!/usr/bin/env python3
"""hbm96_occupy.py — GH200-96GB HBM-budget occupier (standardize_tps_96gb.md).

Allocates ONE idle uint8 tensor sized so the GPU's remaining free HBM equals
--target-free-gib (default 95.6 GiB = a 96-GB GH200's visible HBM, 97,871 MiB),
then sleeps forever. No compute, no CPU/SMEM/register pressure — pure
allocation. Kill with SIGTERM/SIGINT (explicit-PID kills only, house rule).

Target-free sizing (not a fixed 89G) so foreign residents on the GPU are
automatically compensated: dummy = current_free − target_free.

Usage (inside the container, venv python):
  CUDA_VISIBLE_DEVICES=<gpu> .venv/bin/python agent/anchors_tmp/hbm96_occupy.py [--target-free-gib 95.6]
Run ONE occupier per simulated GPU; leave it up for the whole campaign.
"""
import argparse
import os
import signal
import sys
import time

import torch

GIB = 1024 ** 3


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--target-free-gib", type=float, default=95.6,
                    help="HBM to LEAVE free (GiB). 95.6 = 96-GB GH200 visible")
    ap.add_argument("--device", type=int, default=0,
                    help="cuda device index (within CUDA_VISIBLE_DEVICES)")
    args = ap.parse_args()

    torch.cuda.init()
    dev = torch.device(f"cuda:{args.device}")
    target_b = int(args.target_free_gib * GIB)
    blocks = []
    stop = {"flag": False}

    def _bye(signum, frame):
        stop["flag"] = True

    signal.signal(signal.SIGTERM, _bye)
    signal.signal(signal.SIGINT, _bye)

    def rebalance():
        free_b, total_b = torch.cuda.mem_get_info(dev)
        delta = free_b - target_b
        if delta > (1 * GIB) // 2:          # too much free -> grow (0.5G deadband)
            blocks.append(torch.empty(delta, dtype=torch.uint8, device=dev))
            print(f"[hbm96] +{delta/GIB:.1f} GiB (blocks={len(blocks)}) "
                  f"free_now={(torch.cuda.mem_get_info(dev)[0])/GIB:.1f}", flush=True)
        # NO release branch: free < target during a cell is the TRAINER's own
        # allocations (releasing would hand it stolen budget). If a FOREIGN
        # job grows instead, the budget goes conservative-under — cells that
        # OOM at the edge then carry a deficit-inconclusive note (house
        # convention). Grow-only keeps the budget exact at cell boundaries.

    rebalance()
    print(f"[hbm96] pid={os.getpid()} dev={args.device} DYNAMIC target-free="
          f"{args.target_free_gib} GiB, poll 20s", flush=True)
    while not stop["flag"]:
        time.sleep(20)
        try:
            rebalance()
        except torch.cuda.OutOfMemoryError:
            print("[hbm96] grow raced a trainer alloc — retry next poll", flush=True)
    blocks.clear()
    print("[hbm96] released, bye", flush=True)


if __name__ == "__main__":
    main()
